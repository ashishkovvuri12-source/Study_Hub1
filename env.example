# StudyHub Configuration Template
# You can rename this file to .env or set environment variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/studyhub

# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyhub?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=studyhub_super_secret_jwt_key_2024

